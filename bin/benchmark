#!/usr/bin/env php
<?php

declare(strict_types=1);

use Quillstack\Benchmark\Commands\ConsoleBenchmarkCommand;
use Quillstack\Benchmark\Commands\HttpGetBenchmarkCommand;
use Quillstack\Cli\Console;
use Quillstack\DI\Container;

// Installed as a dependency, or run from the repository itself.
foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;

        break;
    }
}

$console = new Console(new Container(), [
    HttpGetBenchmarkCommand::class,
    ConsoleBenchmarkCommand::class,
]);

exit($console->run($argv));
