{
    "name": "quillstack/benchmark",
    "description": "Bash and PHP scripts to benchmark HTTP requests and command line calls.",
    "homepage": "https://quillstack.org/packages/benchmark",
    "type": "library",
    "bin": [
        "bin/benchmark"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Radek Ziemniewicz",
            "email": "radoslaw@ziemniewicz.pl"
        }
    ],
    "require": {
        "php": "^8.1",
        "quillstack/cli": "^0.6",
        "quillstack/di": "^0.6"
    },
    "autoload": {
        "psr-4": {
            "Quillstack\\Benchmark\\": "src/",
            "Quillstack\\Benchmark\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "quillstack/unit-tests": "^0.9"
    },
    "keywords": [
        "benchmark",
        "performance",
        "http",
        "quillstack",
        "php8"
    ],
    "scripts": {
        "test": "unit-tests",
        "test:coverage": "phpdbg -qrr ./vendor/bin/unit-tests",
        "stan": "phpstan analyse"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.0.x-dev"
        }
    }
}
